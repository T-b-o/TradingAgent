@page "/"
@using TradingAgent.Web.Models
@using TradingAgent.Web.Services
@inject TradingAgentApiClient ApiClient

<PageTitle>TradingAgent Overview</PageTitle>

<div class="space-y-6">
    <section class="rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-700 p-8 text-white shadow-soft">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-300">Local AI trading agent</p>
        <h1 class="mt-3 text-3xl font-semibold">TradingAgent dashboard</h1>
        <p class="mt-3 max-w-2xl text-sm text-slate-200">
            Use the browser debugging flow to trace a UI request into the API, then into the local Ollama integration.
        </p>
    </section>

    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Status</p>
            <div class="mt-4 flex items-center gap-3">
                @if (_status is null)
                {
                    <span class="h-3 w-3 animate-pulse rounded-full bg-amber-500"></span>
                    <span class="text-sm text-slate-600">Checking...</span>
                }
                else if (_status.IsSuccess)
                {
                    <span class="h-3 w-3 rounded-full bg-emerald-500"></span>
                    <span class="text-sm font-medium text-emerald-700">Connected</span>
                }
                else
                {
                    <span class="h-3 w-3 rounded-full bg-red-500"></span>
                    <span class="text-sm font-medium text-red-700">Unavailable</span>
                }
            </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Browser flow</p>
            <p class="mt-4 text-lg font-semibold text-slate-900">Blazor → HTTP → API</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Debugging</p>
            <p class="mt-4 text-lg font-semibold text-slate-900">Chrome + Visual Studio</p>
        </div>
    </div>
</div>

@code {
    private ApiResult<ApiStatusResponse>? _status;

    protected override async Task OnInitializedAsync()
    {
        _status = await ApiClient.GetStatusAsync();
    }
}
