@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-100 text-slate-900">
    <div class="mx-auto flex min-h-screen max-w-7xl flex-col lg:flex-row">
        <aside class="bg-slate-900 text-slate-100 lg:w-72">
            <div class="border-b border-slate-700 px-6 py-6">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">TradingAgent</p>
                <h1 class="mt-2 text-2xl font-semibold text-white">Local AI Console</h1>
            </div>
            <NavMenu />
        </aside>

        <main class="flex-1">
            <header class="border-b border-slate-200 bg-white/80 backdrop-blur-sm">
                <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
                    <div>
                        <p class="text-sm font-medium text-slate-500">Phase 02</p>
                        <h2 class="text-lg font-semibold text-slate-900">Browser-to-API debugging</h2>
                    </div>
                </div>
            </header>

            <article class="mx-auto max-w-6xl px-6 py-8">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
